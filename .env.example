# The model is chosen in the app (saved to settings.json). Defaults:
# local model in Ollama (ollama list); for qwen3 also set THINK=false

# Gemini API, free tier: aistudio.google.com -> Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
MODEL=qwen3:14b
THINK=false

# Telegram (my.telegram.org -> API development tools)
TG_API_ID=
TG_API_HASH=
MANAGER_USERNAME=vlad_dev_7

# Voice messages (optional; normally set in the app). Empty = use the app's choice.
# VOICE_START=true -> the first message is a voice note
# VOICE_THEN=mirror (voice note when the manager sent one) | voice | text
VOICE_START=
VOICE_THEN=
# TTS_ENGINE=chatterbox (expressive, needs CHATTERBOX_PYTHON) | kokoro (fast, also the fallback)
TTS_ENGINE=
# python.exe of an environment with `pip install chatterbox-tts` (a GPU helps; CPU works but is slow)
CHATTERBOX_PYTHON=
# British Kokoro voice: bm_george, bm_lewis, bm_daniel, bm_fable, bf_emma, bf_isabella
VOICE=bm_george
# Folder with models/kokoro-v1.0.onnx and voices/voices-v1.0.bin (github.com/thewh1teagle/kokoro-onnx/releases)
KOKORO_DIR=
WHISPER_MODEL=small.en

# For local console tests only, e.g. TEST_LANGUAGE=Russian. Leave empty for the real run (English).
TEST_LANGUAGE=

# Who the agent is and what it may share: see skills/
